# Bake Cycles light (direct + bounced, no albedo) for the architecture of a GLB exported by the editor
# (Ctrl+K "Xuất mô hình 3D (GLB)"). Walls and slabs get one shared lightmap on UV set 1; every material is kept.
# usage: blender -b -P bake_glb.py -- <in.glb> <out_dir> [size=2048] [samples=512] [cut_m=1.0]
# out: baked.glb (TEXCOORD_1 on baked meshes, extras.lightmap = 1), lightmap.png (sRGB-encoded irradiance x scale),
#      manifest.json {lightmap, intensity = pi/scale, channel = 1}. three.js: material.lightMap = tex (SRGBColorSpace),
#      tex.channel = 1, lightMapIntensity = intensity, then turn the realtime lights off for those meshes.
import bpy, json, math, os, sys, time
import numpy as np
from mathutils import Vector

argv = sys.argv[sys.argv.index("--") + 1:]
GLB, OUT = argv[0], argv[1]
SIZE = int(argv[2]) if len(argv) > 2 else 2048
SAMPLES = int(argv[3]) if len(argv) > 3 else 512
BAKED = ("wall", "slab")      # editor node types whose meshes get the lightmap (items stay realtime-lit)
CUT_M = float(argv[4]) if len(argv) > 4 else 1.0   # cut height above the slab top; 0 = keep full walls
CEILING_Z = 2.8               # dollhouse view: drop ceilings and anything hanging from them
TOP = 0.9                     # 99.5th percentile of the lightmap lands here after scaling
WARM = np.array([1.0, 0.97, 0.92], np.float32) / 0.9633   # average light colour after white balance (mean 1)
os.makedirs(OUT, exist_ok=True)
t0 = time.time()

bpy.ops.wm.read_factory_settings(use_empty=True)
scene = bpy.context.scene
bpy.ops.import_scene.gltf(filepath=GLB)
for o in list(scene.objects):
    if o.type in ("LIGHT", "CAMERA"):
        bpy.data.objects.remove(o)


def kind(o):  # nearest ancestor named "<type>_<id>" by the editor export
    while o:
        head = o.name.split("_")[0]
        if head in ("wall", "slab", "ceiling", "item", "door", "window", "zone", "roof", "stair"):
            return head
        o = o.parent
    return None


def zmin(o):
    return min((o.matrix_world @ Vector(c)).z for c in o.bound_box)


for o in [o for o in scene.objects if o.type == "MESH" and (kind(o) == "ceiling" or zmin(o) > CEILING_Z)]:
    bpy.data.objects.remove(o)
meshes = [o for o in scene.objects if o.type == "MESH"]

# overview cut like the editor's "Tường: cắt" and the Blender reference: everything above slab top + CUT_M is
# removed, the cut is capped with near-black #141416 (bmesh bisect + hole fill, per object in its local space)
if CUT_M > 0:
    import bmesh
    slab_top = max((max((o.matrix_world @ Vector(c)).z for c in o.bound_box) for o in meshes if kind(o) == "slab"), default=0.0)
    cut_z = slab_top + CUT_M
    cap = bpy.data.materials.new("cut-cap"); cap.use_nodes = True
    cap.node_tree.nodes["Principled BSDF"].inputs["Base Color"].default_value = (0.0070, 0.0070, 0.0080, 1)  # #141416
    cap.node_tree.nodes["Principled BSDF"].inputs["Roughness"].default_value = 0.9
    ncut = 0
    for o in meshes:
        if max((o.matrix_world @ Vector(c)).z for c in o.bound_box) <= cut_z:
            continue
        if zmin(o) >= cut_z:  # wholly above the cut; keep the object if children hang off its transform
            if o.children: o.data = bpy.data.meshes.new("cut-away")
            else: bpy.data.objects.remove(o)
            continue
        if o.data.users > 1:
            o.data = o.data.copy()
        inv = o.matrix_world.inverted()
        co = inv @ Vector((0, 0, cut_z)); no = (o.matrix_world.to_3x3().transposed() @ Vector((0, 0, 1))).normalized()
        bm = bmesh.new(); bm.from_mesh(o.data)
        bmesh.ops.remove_doubles(bm, verts=bm.verts, dist=0.0005)
        res = bmesh.ops.bisect_plane(bm, geom=bm.verts[:] + bm.edges[:] + bm.faces[:], plane_co=co, plane_no=no, clear_outer=True)
        edges = [e for e in res["geom_cut"] if isinstance(e, bmesh.types.BMEdge)]
        o.data.materials.append(cap); ci = len(o.data.materials) - 1
        for f in bmesh.ops.holes_fill(bm, edges=edges, sides=0)["faces"]:
            f.material_index = ci
        bm.to_mesh(o.data); bm.free(); ncut += 1
    meshes = [o for o in scene.objects if o.type == "MESH"]
    print("CUT at", round(cut_z, 3), "objects", ncut)
bake = [o for o in meshes if kind(o) in BAKED and len(o.data.polygons)]
print("MESHES", len(meshes), "BAKED", len(bake))

# ground + sky + sun: the same rig as blender-spike/render_glb.py
pts = [o.matrix_world @ Vector(c) for o in meshes for c in o.bound_box]
lo = Vector([min(p[i] for p in pts) for i in range(3)]); hi = Vector([max(p[i] for p in pts) for i in range(3)])
ctr, size = (lo + hi) / 2, hi - lo
bpy.ops.mesh.primitive_plane_add(size=1, location=(ctr.x, ctr.y, lo.z - 0.01))
g = bpy.context.object; g.scale = (size.x + 6, size.y + 6, 1)
gm = bpy.data.materials.new("ground"); gm.use_nodes = True
gm.node_tree.nodes["Principled BSDF"].inputs["Base Color"].default_value = (0.55, 0.56, 0.55, 1)
gm.node_tree.nodes["Principled BSDF"].inputs["Roughness"].default_value = 0.95
g.data.materials.append(gm)
world = bpy.data.worlds.new("w"); scene.world = world; world.use_nodes = True
wn, wl = world.node_tree.nodes, world.node_tree.links
sky = wn.new("ShaderNodeTexSky"); sky.sky_type = "NISHITA"; sky.sun_disc = False
sky.sun_elevation = math.radians(35); sky.sun_rotation = math.radians(140)
wl.new(sky.outputs["Color"], wn["Background"].inputs["Color"])
wn["Background"].inputs["Strength"].default_value = 0.25
sd = bpy.data.lights.new("sun", "SUN"); sd.energy = 4.0; sd.angle = math.radians(1.5); sd.color = (1.0, 0.93, 0.82)
sun = bpy.data.objects.new("sun", sd); scene.collection.objects.link(sun)
sun.rotation_euler = (math.radians(55), 0, math.radians(230))

# one shared atlas: single-user meshes, only the material UV set kept, then "lightmap" packed across all objects
vl = bpy.context.view_layer
for o in vl.objects:
    o.select_set(False)
for o in bake:
    if o.data.users > 1:
        o.data = o.data.copy()
    for uv in list(o.data.uv_layers)[1:]:
        o.data.uv_layers.remove(uv)
    if not o.data.uv_layers:
        o.data.uv_layers.new(name="UVMap")
    o.data.uv_layers.active = o.data.uv_layers.new(name="lightmap")
    o.select_set(True)
vl.objects.active = bake[0]
bpy.ops.object.mode_set(mode="EDIT"); bpy.ops.mesh.select_all(action="SELECT")
bpy.ops.mesh.remove_doubles(threshold=0.0005)   # glTF import leaves every triangle loose -> thousands of tiny islands
bpy.ops.uv.lightmap_pack(PREF_CONTEXT="ALL_FACES", PREF_PACK_IN_ONE=True, PREF_NEW_UVLAYER=False,
                         PREF_BOX_DIV=48, PREF_MARGIN_DIV=0.2)
bpy.ops.uv.pack_islands(rotate=True, shape_method="CONVEX", margin_method="FRACTION", margin=0.002)  # lightmap_pack leaves ~70 % empty
bpy.ops.object.mode_set(mode="OBJECT")


def uv_cover(objs):  # share of the atlas covered by faces, and texels per metre it buys
    uv_a = m_a = 0.0
    for o in objs:
        me = o.data; uvs = me.uv_layers["lightmap"].data; sc = o.matrix_world.to_scale(); s2 = abs(sc.x * sc.y * sc.z) ** (2 / 3)
        for p in me.polygons:
            q = [uvs[i].uv for i in p.loop_indices]
            uv_a += abs(sum(q[i].x * q[i - 1].y - q[i - 1].x * q[i].y for i in range(len(q)))) / 2
            m_a += p.area * s2
    return uv_a, SIZE * math.sqrt(uv_a / max(m_a, 1e-6))


cov, tpm = uv_cover(bake)
print(f"UV {time.time() - t0:.1f}s cover {cov:.2f} texels/m {tpm:.0f}")

img = bpy.data.images.new("lightmap", SIZE, SIZE, float_buffer=True)
added = []
for m in {s.material for o in bake for s in o.material_slots if s.material}:
    m.use_nodes = True
    nd = m.node_tree.nodes.new("ShaderNodeTexImage"); nd.image = img
    m.node_tree.nodes.active = nd; added.append((m, nd))

r = scene.render; r.engine = "CYCLES"
prefs = bpy.context.preferences.addons["cycles"].preferences
for t in ("OPTIX", "CUDA"):
    try:
        prefs.compute_device_type = t; prefs.get_devices(); break
    except TypeError:
        continue
for dv in prefs.devices:
    dv.use = dv.type != "CPU"
scene.cycles.device = "GPU"; scene.cycles.samples = SAMPLES
bk = r.bake; bk.use_pass_direct = bk.use_pass_indirect = True; bk.use_pass_color = False; bk.margin = 8
bpy.ops.object.bake(type="DIFFUSE", pass_filter={"DIRECT", "INDIRECT"}, margin=8, use_clear=True)
print(f"BAKE {time.time() - t0:.1f}s")

# irradiance -> scale so the bright end fits 8 bits -> sRGB curve, written raw into a Non-Color PNG
px = np.empty(SIZE * SIZE * 4, np.float32); img.pixels.foreach_get(px); px = px.reshape(-1, 4)
lit = px[:, :3][px[:, 3] > 0]
if lit.size:  # white balance: the sky tints the bounce blue; pull the lit average to a warm neutral
    lit = lit * (WARM / np.maximum(lit.mean(0), 1e-6)) * float(lit.mean())
    px[:, :3] *= WARM / np.maximum(px[:, :3][px[:, 3] > 0].mean(0), 1e-6) * float(px[:, :3][px[:, 3] > 0].mean())
scale = TOP / max(float(np.percentile(lit, 99.5)), 1e-4) if lit.size else 1.0
c = np.clip(px[:, :3] * scale, 0, 1)
px[:, :3] = np.where(c <= 0.0031308, c * 12.92, 1.055 * np.power(c, 1 / 2.4) - 0.055); px[:, 3] = 1
out = bpy.data.images.new("lightmap_srgb", SIZE, SIZE); out.colorspace_settings.name = "Non-Color"
out.pixels.foreach_set(px.ravel())
out.filepath_raw = os.path.join(OUT, "lightmap.png"); out.file_format = "PNG"; out.save()

for m, nd in added:
    m.node_tree.nodes.remove(nd)
for o in bake:
    o["lightmap"] = 1
    o.data.uv_layers.active = o.data.uv_layers[0]
for o in vl.objects:
    o.select_set(o.type == "MESH" and o is not g)
bpy.ops.export_scene.gltf(filepath=os.path.join(OUT, "baked.glb"), export_format="GLB", use_selection=True,
                          export_extras=True, export_lights=False, export_cameras=False)
json.dump({"lightmap": "lightmap.png", "intensity": math.pi / scale, "channel": 1, "baked": len(bake),
           "size": SIZE, "samples": SAMPLES}, open(os.path.join(OUT, "manifest.json"), "w"), indent=1)
print(f"DONE {time.time() - t0:.1f}s scale {scale:.4f}")
