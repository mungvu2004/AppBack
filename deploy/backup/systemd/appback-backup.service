# Chạy backup.sh một lần theo lịch của appback-backup.timer (B0-10 [2]).
# Múi giờ OnCalendar của timer đi cạnh là GIỜ MÁY (systemd), không phải UTC.
[Unit]
Description=Sao lưu AppBack (Postgres + kho object)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
EnvironmentFile=/etc/appback/appback.env
WorkingDirectory=/opt/appback
ExecStart=/opt/appback/backup/backup.sh
