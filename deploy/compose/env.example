# Mẫu biến môi trường cho deploy/compose/{base,dev,ci,prod}.yml.
# Sao thành .env (đã bị .gitignore bỏ qua) rồi điền giá trị thật; KHÔNG commit .env.
# Giá trị bí mật để trống hoặc "change-me" — không giá trị thật trong file này.

# --- Lõi ứng dụng (api, worker, beat, ml, migrate) ---
APP_ENV=dev
PUBLIC_BASE_URL=http://localhost:8080
SECRET_KEY=change-me-32-bytes-minimum-please
SECRET_KEY_PREVIOUS=

# --- Postgres (packages/db) ---
DATABASE_URL=postgresql+asyncpg://appback:change-me-pg@postgres:5432/appback
POSTGRES_USER=appback
# Phải khớp mật khẩu nhúng trong DATABASE_URL ở trên — postgres tự đặt mật khẩu
# role bằng biến này, api/worker/… kết nối bằng DATABASE_URL, không đọc lại biến này.
POSTGRES_PASSWORD=change-me-pg
POSTGRES_DB=appback

# --- Redis (packages/messaging) ---
REDIS_BROKER_URL=redis://redis-broker:6379/0
REDIS_CACHE_URL=redis://redis-cache:6379/0

# --- Celery / hàng đợi (packages/messaging, đi qua &app-env của base.yml) ---
# Mặc định khớp packages/messaging/settings.py — chỉnh khi cần khác đi.
CELERY_VISIBILITY_TIMEOUT_S=7200
TASK_TIME_LIMIT_S=3600
TASK_SOFT_TIME_LIMIT_S=3300
TASK_RETRY_BACKOFF_S=10,60,300
STREAM_MAXLEN=1000

# --- Lưu trữ đối tượng (packages/storage) ---
# STORAGE_BACKEND=local dùng STORAGE_LOCAL_ROOT; STORAGE_BACKEND=s3 dùng nhóm S3_* dưới đây.
# Ba khoá MinIO (S3_ACCESS_KEY, S3_ML_ACCESS_KEY, MINIO_ROOT_USER) PHẢI khác nhau:
# MinIO từ chối tạo user có access key trùng access key gốc (root) hay user khác
# ("Credential is not allowed to be same as admin access key") — sao nguyên xi ba
# khoá giống nhau làm minio-init thoát khác 0 và dev/ci không lên (review
# 2026-09-22 #15, OPS-02 · R-34). Mật khẩu/khoá bí mật ≥ 8 ký tự, khoá công khai
# ≥ 3 ký tự (MinIO đòi hỏi tối thiểu).
STORAGE_BACKEND=s3
STORAGE_LOCAL_ROOT=/var/lib/appback/storage
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=appback
S3_ACCESS_KEY=change-me-api-access
S3_SECRET_KEY=change-me-api-secret
S3_REGION=us-east-1

# --- Khoá MinIO riêng của dịch vụ ml (không dùng khoá chung, BE-00 §8) ---
S3_ML_ACCESS_KEY=change-me-ml-access
S3_ML_SECRET_KEY=change-me-ml-secret

# --- Khoá gốc MinIO (chỉ minio, minio-init dùng) ---
MINIO_ROOT_USER=change-me-minio-root
MINIO_ROOT_PASSWORD=change-me-minio-root-pw

# --- Thư ---
SMTP_URL=smtp://mailpit:1025

# --- nginx / uvicorn proxy ---
# Subnet cố định của mạng appback (uvicorn 0.53.0 nhận CIDR).
FORWARDED_ALLOW_IPS=192.168.200.0/24

# --- ML ---
ML_DEVICE=auto
ML_MEM_LIMIT=6g

# --- worker ---
WORKER_CONCURRENCY=2
WORKER_MEM_LIMIT=3g

# --- Ảnh (ci/prod dùng ảnh đã build; để trống IMAGE_REGISTRY để chạy ảnh cục bộ) ---
IMAGE_REGISTRY=
IMAGE_TAG=dev

# --- Build web (AppFront), chỉ dev/ci ---
APPFRONT_CONTEXT=
APPFRONT_SHA=

# --- Chứng chỉ TLS, chỉ prod ---
TLS_CERT_DIR=/etc/appback/tls

# --- Cổng host (đổi khi máy đã bận cổng mặc định) ---
WEB_HTTP_PORT=8080
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_BROKER_HOST_PORT=6379
REDIS_CACHE_HOST_PORT=6380
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
