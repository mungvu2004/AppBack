# Server app dev: chỉ http trên 8080, cùng origin với /api (W19).
map $http_x_request_id $appback_request_id {
    "~^[A-Za-z0-9-]{8,64}$" $http_x_request_id;
    default $request_id;
}

# Biến nginx mức http cho giá trị theo môi trường dùng trong snippets/security_headers.conf.
map '' $csp_s3_origin {
    default "${S3_PUBLIC_ENDPOINT}";
}

# Rỗng ở dev: add_header với biến rỗng không gửi header (đã kiểm bằng chạy thực).
map '' $hsts_header {
    default "";
}

resolver 127.0.0.11 valid=10s;

server {
    listen 8080 default_server;
    root /usr/share/nginx/html;

    # Dùng bởi snippets/proxy_common.conf (BE-00 §11): chuẩn hoá bỏ cổng.
    set $appback_proxy_host $host;

    include /etc/nginx/appback/snippets/app_locations.conf;
}
