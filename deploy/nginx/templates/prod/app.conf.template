# Server app prod: 8080 chỉ chuyển sang https; 8443 ssl + http2 phục vụ thật.
map $http_x_request_id $appback_request_id {
    "~^[A-Za-z0-9-]{8,64}$" $http_x_request_id;
    default $request_id;
}

# Biến nginx mức http cho giá trị theo môi trường dùng trong snippets/security_headers.conf.
map '' $csp_s3_origin {
    default "${S3_PUBLIC_ENDPOINT}";
}

map '' $hsts_header {
    default "max-age=63072000; includeSubDomains; preload";
}

resolver 127.0.0.11 valid=10s;

# Server 301 này không include app_locations.conf nên không chịu luật log của
# location /api/files/: client gọi http://…/api/files/<token> (hoặc URL ký S3
# bằng http) để lại token trong access log mặc định của ảnh nền trước khi được
# chuyển sang https (NO-094). Không có gì đáng ghi ở đây — mọi yêu cầu đều trả
# đúng một 301, log thật nằm ở server 8443.
server {
    listen 8080 default_server;
    access_log off;
    return 301 https://$host$request_uri;
}

server {
    listen 8443 ssl default_server;
    http2 on;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    root /usr/share/nginx/html;

    # Dùng bởi snippets/proxy_common.conf (BE-00 §11): chuẩn hoá bỏ cổng.
    set $appback_proxy_host $host;

    include /etc/nginx/appback/snippets/app_locations.conf;
}
