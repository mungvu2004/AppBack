# Unit systemd cho healthcheck.sh — người điều phối cài vào /etc/systemd/system/
# trên VPS (deploy/scripts/README.md ghi lệnh). Chạy bằng người dùng deploy,
# đọc bí mật từ /etc/appback/appback.env (ALERT_WEBHOOK_URL, APPBACK_BASE_URL…).
[Unit]
Description=AppBack — kiem suc khoe dinh ky (api/ready, dia)
After=network-online.target

[Service]
Type=oneshot
User=deploy
EnvironmentFile=/etc/appback/appback.env
ExecStart=/opt/appback/scripts/healthcheck.sh
